<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="005-create-deployments-table" author="devops-panel">
        <createTable tableName="deployments">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_deployments_project" references="projects(id)"/>
            </column>
            <column name="environment_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_deployments_environment" references="environments(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_deployments_project_id" tableName="deployments">
            <column name="project_id"/>
        </createIndex>
        <createIndex indexName="idx_deployments_environment_id" tableName="deployments">
            <column name="environment_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
