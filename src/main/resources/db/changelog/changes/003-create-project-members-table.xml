<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-project-members-table" author="devops-panel">
        <createTable tableName="project_members">
            <column name="project_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_members_project" references="projects(id)"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_members_user" references="users(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="project_members" columnNames="project_id, user_id"/>
    </changeSet>
</databaseChangeLog>
