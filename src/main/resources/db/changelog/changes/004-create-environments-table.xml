<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-environments-table" author="devops-panel">
        <createTable tableName="environments">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="VARCHAR(500)"/>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_environments_project" references="projects(id)"/>
            </column>
        </createTable>
        <createIndex indexName="idx_environments_project_id" tableName="environments">
            <column name="project_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
